# ==============================================================================
# Stage 1: builder — full CUDA devel image with all compilers and build tools
# ==============================================================================
FROM nvidia/cuda:12.6.0-devel-ubuntu24.04 AS builder

ARG VERSION
ARG GITHUB_TOKEN
ARG OPENMPI_VERSION=5.0.3
ARG CUDA_ARCH=80

ENV DEBIAN_FRONTEND=noninteractive
# Required for nvcc to find the correct host compiler
ENV CUDAHOSTCXX=/usr/bin/g++
# Required for MPI to run as root inside Docker
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
# Fixes MPI_ERR_BUFFER in Docker (disables shared memory copy mechanism)
ENV OMPI_MCA_btl_vader_single_copy_mechanism=none
ENV OMPI_MCA_btl=^openib

RUN mkdir -p /opt/palace-src

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        gcc \
        g++ \
        gfortran \
        git \
        libunwind-dev \
        libopenblas-dev \
        pkg-config \
        python3 \
        wget \
        zlib1g-dev \
        ca-certificates \
        cmake \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Build GPU-aware OpenMPI with CUDA support
RUN wget https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-${OPENMPI_VERSION}.tar.gz && \
    tar xf openmpi-${OPENMPI_VERSION}.tar.gz && \
    cd openmpi-${OPENMPI_VERSION} && \
    ./configure \
        --with-cuda=/usr/local/cuda \
        --with-cuda-libdir=/usr/local/cuda/lib64/stubs \
        --prefix=/usr/local \
        --enable-mpi-fortran \
        --enable-shared \
    && make -j"$(nproc)" install \
    && ldconfig \
    && cd / && rm -rf openmpi-${OPENMPI_VERSION} openmpi-${OPENMPI_VERSION}.tar.gz

# Configure git to use GitHub token for authenticated requests
RUN if [ -n "$GITHUB_TOKEN" ]; then \
        git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/" ; \
    fi

# Configure curl to add Authorization header for GitHub requests
RUN if [ -n "$GITHUB_TOKEN" ]; then \
        mkdir -p ~/.curlrc.d && \
        echo 'header = "Authorization: token '${GITHUB_TOKEN}'"' > /root/.curlrc ; \
    fi

# Add retry logic for wget and curl
RUN echo "tries = 5" >> /etc/wgetrc && \
    echo "waitretry = 2" >> /etc/wgetrc && \
    echo "timeout = 30" >> /etc/wgetrc && \
    echo "retry = 5" >> /root/.curlrc && \
    echo "retry-delay = 2" >> /root/.curlrc && \
    echo "connect-timeout = 30" >> /root/.curlrc

# Clone Palace
RUN git clone https://github.com/awslabs/palace.git /opt/palace-src && \
    cd /opt/palace-src && \
    git checkout ${VERSION}

# Patch PkgConfigHelpers.cmake to replace try_run with try_compile for PETSc and SLEPc
# try_run fails in Docker because MPI cannot initialize properly without a real network
# environment. Compilation success is sufficient to verify the libraries are correct.
COPY patch_pkgconfig.py /tmp/patch_pkgconfig.py
RUN python3 /tmp/patch_pkgconfig.py

# Create libcuda.so.1 stub symlink for build-time linking without a GPU driver
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1

# Build Palace
RUN mkdir -p /opt/palace-build && cd /opt/palace-build && \
    if [ -n "$GITHUB_TOKEN" ]; then \
        CMAKE_EXTRA_ARGS="-DCMAKE_TLS_VERIFY=ON" ; \
    else \
        CMAKE_EXTRA_ARGS="" ; \
    fi && \
    CUDAHOSTCXX=/usr/bin/g++ \
    LDFLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH}" \
    cmake /opt/palace-src \
        -DCMAKE_INSTALL_PREFIX=/opt/palace \
        -DCMAKE_BUILD_TYPE="Release" \
        -DCMAKE_CXX_COMPILER=g++ \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_Fortran_COMPILER=gfortran \
        -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
        -DCMAKE_CUDA_HOST_COMPILER=/usr/bin/g++ \
        -DCMAKE_CXX_FLAGS="-fPIC -O3 -fno-lto" \
        -DCMAKE_C_FLAGS="-fPIC -O3 -fno-lto" \
        -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
        -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
        -DCMAKE_MODULE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
        -DBUILD_SHARED_LIBS:BOOL=ON \
        -DPALACE_WITH_64BIT_INT:BOOL=OFF \
        -DPALACE_WITH_OPENMP:BOOL=ON \
        -DPALACE_WITH_CUDA:BOOL=ON \
        -DPALACE_WITH_HIP:BOOL=OFF \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
        -DPALACE_WITH_GPU_AWARE_MPI:BOOL=ON \
        -DPALACE_WITH_SUPERLU:BOOL=ON \
        -DPALACE_WITH_STRUMPACK:BOOL=ON \
        -DPALACE_WITH_STRUMPACK_BUTTERFLYPACK:BOOL=OFF \
        -DPALACE_WITH_STRUMPACK_ZFP:BOOL=ON \
        -DPALACE_WITH_MUMPS:BOOL=ON \
        -DPALACE_WITH_SLEPC:BOOL=ON \
        -DPALACE_WITH_ARPACK:BOOL=ON \
        -DPALACE_WITH_LIBXSMM:BOOL=ON \
        -DPALACE_WITH_MAGMA:BOOL=ON \
        -DPALACE_WITH_GSLIB:BOOL=ON \
        ${CMAKE_EXTRA_ARGS} && \
    make -j"$(nproc)" && \
    make install && \
    cd / && rm -rf /opt/palace-build /opt/palace-src

# Clear credentials after build (security best practice)
RUN git config --global --unset url."https://${GITHUB_TOKEN}@github.com/".insteadOf || true && \
    rm -f /root/.curlrc

# ==============================================================================
# Stage 2: runtime — minimal CUDA runtime image, no compilers or build tools
# ==============================================================================
FROM nvidia/cuda:12.6.0-runtime-ubuntu24.04

ARG VERSION
ARG CUDA_ARCH=80

LABEL org.opencontainers.image.title="Palace (GPU sm${CUDA_ARCH})" \
      org.opencontainers.image.source="https://github.com/benvial/palace-docker" \
      org.opencontainers.image.revision=$VERSION \
      org.opencontainers.image.base.name="nvidia/cuda:12.6.0-runtime-ubuntu24.04" \
      org.opencontainers.image.description="This container contains Palace compiled with all dependencies (with CUDA GPU support, sm${CUDA_ARCH})."

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/palace/bin:${PATH}"
# Allow running as root (common in container environments)
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
# Fixes MPI shared memory issues in Docker/container environments
ENV OMPI_MCA_btl_vader_single_copy_mechanism=none
ENV OMPI_MCA_btl=^openib

# Install only runtime dependencies (no compilers)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas-dev \
        libunwind-dev \
        ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Palace binary and dependencies from builder
COPY --from=builder /opt/palace /opt/palace

# Copy OpenMPI runtime libraries from builder
COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/bin/mpi* /usr/local/bin/
COPY --from=builder /usr/local/bin/orte* /usr/local/bin/
COPY --from=builder /usr/local/etc/openmpi /usr/local/etc/openmpi

RUN ldconfig

CMD ["/bin/bash"]